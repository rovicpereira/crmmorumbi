# Banco de dados (local via docker-compose, ou string de conexão do Railway/outro provedor)
DATABASE_URL="postgresql://morumbi:morumbi@localhost:5432/morumbi_crm"

# NextAuth
# Gere um valor aleatório com: npx auth secret  (ou qualquer string longa e aleatória)
NEXTAUTH_SECRET="troque-por-um-valor-aleatorio-longo"
NEXTAUTH_URL="http://localhost:3000"

# Usuário admin criado pelo seed inicial (prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@morumbi.local"
SEED_ADMIN_SENHA="troque-esta-senha"

# WhatsApp Cloud API (ver docs/meta-whatsapp-setup.md para obter estes valores)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN="escolha-uma-frase-secreta-para-o-webhook"

# Regras de lembrete automático de follow-up
LEMBRETE_DIAS_SEM_RESPOSTA="3"

# Pasta onde a mídia recebida (imagens/áudio) é salva localmente
MEDIA_STORAGE_PATH="./storage/media"

# OpenAI — usado na simulação de ambientes (aplicar piso/revestimento/tinta
# em foto do cliente). Gere a chave em platform.openai.com/api-keys
OPENAI_API_KEY=""

# Anthropic (Claude) — reservado para o futuro agente de IA de vendas via
# WhatsApp. Ainda não usado no código; gere em console.anthropic.com
ANTHROPIC_API_KEY=""
